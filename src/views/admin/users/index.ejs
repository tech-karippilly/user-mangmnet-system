<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 250px;
            background-color: #48b2a6;
            color: white;
            display: flex;
            flex-direction: column;
            padding-top: 20px;
        }

        .sidebar h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar a {
            text-decoration: none;
            color: white;
            padding: 15px;
            margin: 5px 0;
            display: block;
            text-align: center;
            background-color: #3aa59a;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .sidebar a:hover {
            background-color: #319187;
        }

        .main-content {
            flex: 1;
            background-color: #f5f5f5;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #48b2a6;
            padding: 10px 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .topbar input[type="text"] {
            width: 300px;
            padding: 5px 10px;
            border: none;
            border-radius: 5px;
        }

        .topbar button {
            background-color: white;
            color: #48b2a6;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s;
        }

        .topbar button:hover {
            background-color: #3aa59a;
            color: white;
        }

        .welcome {
            text-align: center;
            font-size: 24px;
            margin-top: 50px;
        }

        .welcome p {
            margin-top: 10px;
            font-size: 18px;
            color: #666;
        }

        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .content-title {
            font-size: 28px;
            font-weight: bold;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .table th,
        .table td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        .pagination {
            display: flex;
            list-style: none;
            padding: 0;
            margin: 20px 0;
        }

        .pagination li {
            margin: 0 5px;
        }

        .pagination a {
            text-decoration: none;
            color: #48b2a6;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .pagination .active a {
            background-color: #48b2a6;
            color: white;
            border: 1px solid #48b2a6;
            
        }

        .btn {
            padding: 5px 10px;
            border-radius: 3px;
            cursor: pointer;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
            border: none;
        }

        .btn-danger {
            background-color: #dc3545;
            color: white;
            border: none;
        }
.btn-light.create-btn {
    padding: 10px 20px;
    background-color: #3aa59a;
    border:bold ;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

.btn-light.create-btn a {
    color:white; /* Text color */
    text-decoration: none; /* Remove underline */
}

.btn-light.create-btn a:hover {
    color: red; /* Change text color on hover */
}


        .btn-sm {
            padding: 3px 7px;
            font-size: 12px;
        }
        .admin{
            margin-left: 30rem;
        }
        .search-button{
            margin-left: 10px;
        }

        .navbar{
            padding-top: 70px;
        }

        .btn-logout {
            background-color: #f8f9fa;
            color: #333;
            border: 1px solid #ddd;
            padding: 5px 10px;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h2>myProject</h2>
        <a href="#">User Administration</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/dashboard">Back to Home</a>
    </div>
    <div class="main-content">
        <div class="topbar">
            <form class="d-flex" action="/admin/users/search" method="get" role="search">
                <input class="form-control me-2" name="searchString" type="search" placeholder="Search"
                    aria-label="Search">
                <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
            <p class="admin">Admin</p>
            <button><a href="/admin/logout">Logout</a></button>
        </div>
        <div class="welcome">
            <h1>User Management System</h1>
            
        </div>
        <div class="content">
            <nav class="navbar navbar-expand-lg">
                <div class="d-flex flex-grow-1 align-items-center">
                    
                   <!-- <button class="btn btn-light create-btn"><a href="/admin/createUser">Create New User</a></button>-->
                        
                    
                </div>
                <div class="d-flex align-items-center ms-auto">
                    <a href="#" class="btn btn-link text-light">
                        <i class="bi bi-envelope"></i>
                    </a>
                    <a href="#" class="btn btn-link text-light">
                        <i class="bi bi-person-circle"></i>
                    </a>
                   
                </div>
            </nav>
            <div class="content-header row">
                <h2 class="content-title card-title">Customers</h2>
            </div>
            
            <div class="right mt-5">
                <% if(data.length > 0){ %>
                    <div>
                        <a class="btn btn-primary" href="/admin/createUser" style="text-decoration: none;">Create User</a>
                    </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone No</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                        <% for(let i = 0; i < data.length; i++) { %>
                        <tr>
                            <td><%= data[i].name %></td>
                            <td><%= data[i].email %></td>
                            <td><%= data[i].phone %></td>
                            <td>
                                <a href="/admin/editUser?id=<%=data[i]._id%>" class="btn-primary btn-sm">Edit</a>
                                <a href="/admin/deleteUser?id=<%=data[i]._id%>" class="btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                        <% } %>
                        
                    </tbody>
                </table>
                <% }else{ %>
                    <h1>No Users</h1>
                <% } %>
            </div>
            <div class="container mt-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <% for(let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                            <a class="page-link" href="/admin/users?page=<%= i %>"><%= i %></a>
                        </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
        </script> <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>