<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Styles */
        .sidebar {
            width: 250px;
            background-color: #48b2a6;
            color: white;
            display: flex;
            flex-direction: column;
            padding-top: 20px;
        }

        .sidebar h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar a {
            text-decoration: none;
            color: white;
            padding: 15px;
            margin: 5px 0;
            display: block;
            text-align: center;
            background-color: #3aa59a;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .sidebar a:hover {
            background-color: #319187;
        }

        /* Main Content Styles */
        .main-content {
            flex: 1;
            background-color: #f5f5f5;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #48b2a6;
            padding: 10px 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .topbar input[type="text"] {
            width: 300px;
            padding: 5px 10px;
            border: none;
            border-radius: 5px;
        }

        .topbar button {
            background-color: white;
            color: #48b2a6;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s;
        }

        .topbar button:hover {
            background-color: #3aa59a;
            color: white;
        }

        .admin{
            margin-left: 37rem;}

        .welcome {
            text-align: center;
            font-size: 24px;
            margin-top: 50px;
        }

        .welcome p {
            margin-top: 10px;
            font-size: 18px;
            color: #666;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <h2>myProject</h2>
        <a href="#">Dashboard</a>
        <a href="/admin/users">Users</a>       
        <a href="#">About</a>        
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="topbar">
            <input type="text" placeholder="Search...">
            <p class="admin">Admin</p>
            <button><a href="/admin/logout">Logout</a></button>
        </div>
        <div class="welcome">
            <h1>Welcome to the Admin Dashboard</h1>
            <p>Select an option from the sidebar to get started.</p>
        </div>
    </div>
</body>
</html>